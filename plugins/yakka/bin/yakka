#!/bin/bash
# Dispatches plugin commands to the Python client, or execs YAKKA_BIN when set.
# bash 3.2 compatible. See docs/design/05-distribution.md.
ROOT=$(cd "$(dirname "$0")/.." && pwd -P) || exit 1
export YAKKA_ROOT="$ROOT"
CLIENT="$ROOT/client/yakka.py"

usage() {
  echo "usage: yakka serve | drain | login [start|wait] [--endpoint URL] | ledger compact --tenant-dir <dir> | ledger purge-deltas --tenant-dir <dir> | mcp | status | version" >&2
}

# 1. development override
if [ -n "${YAKKA_BIN:-}" ] && [ -x "$YAKKA_BIN" ]; then
  exec "$YAKKA_BIN" "$@"
fi

if [ $# -eq 0 ]; then
  usage
  exit 2
fi

case "$1" in
  drain|mcp|login|status|version|--version)
    exec python3 "$CLIENT" "$@"
    ;;
  serve|ledger)
    echo "yakka: serve and ledger require the Go collector binary (build from packages/yakka); not available through the plugin wrapper" >&2
    exit 1
    ;;
  *)
    usage
    exit 2
    ;;
esac
