{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash \"/ABS/PATH/workflow-plugin/tools/hooklog/spool.sh\" --harness cursor --event sessionStart",
        "timeout": 5
      },
      {
        "command": "nohup bash \"/ABS/PATH/workflow-plugin/bin/workflow\" --version </dev/null >/dev/null 2>&1 & exit 0",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "bash \"/ABS/PATH/workflow-plugin/tools/hooklog/spool.sh\" --harness cursor --event sessionEnd",
        "timeout": 5
      }
    ],
    "preToolUse": [
